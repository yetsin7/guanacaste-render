                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=CloudDirectionSlider, StringFormat={}{0:0}°}"/>
                    <Slider x:Name="CloudDirectionSlider" Minimum="-180" Maximum="180" Value="0" TickFrequency="5"
                            IsSnapToTickEnabled="True" ValueChanged="Lighting_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="Turbidez atmosférica"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=TurbiditySlider, StringFormat={}{0:0.0}}"/>
                    <Slider x:Name="TurbiditySlider" Minimum="1.7" Maximum="10" Value="2.8" TickFrequency="0.1"
                            ValueChanged="Lighting_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="Potencia solar"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=SunStrengthSlider, StringFormat={}{0:0.00}}"/>
                    <Slider x:Name="SunStrengthSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                            ValueChanged="Lighting_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="Intensidad ambiental"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=SkyStrengthSlider, StringFormat={}{0:0.00}}"/>
                    <Slider x:Name="SkyStrengthSlider" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                            ValueChanged="Lighting_SliderChanged"/>
                  </DockPanel>


                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Hour}"/>
                  <Grid x:Name="SunControls"><StackPanel>
                    <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Date}" Margin="0,4,0,4"/>
                    <DatePicker x:Name="SunDatePicker" SelectedDateFormat="Short" SelectedDateChanged="Lighting_Changed" MinHeight="30"/>
                    <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Hour}"/>
                    <DockPanel>
                      <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=HourSlider, StringFormat={}{0:0.0} h}"/>
                      <Slider x:Name="HourSlider" Minimum="5" Maximum="19" Value="10" TickFrequency="0.25"
                              IsSnapToTickEnabled="True" ValueChanged="Lighting_SliderChanged"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Clouds}"/>
                    <DockPanel>
                      <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=CloudSlider, StringFormat={}{0:0} %}"/>
                      <Slider x:Name="CloudSlider" Minimum="0" Maximum="100" Value="30" TickFrequency="5"
                              IsSnapToTickEnabled="True" ValueChanged="Lighting_SliderChanged"
                              ToolTip="{DynamicResource RenderPanel.CloudsHint}"/>
                    </DockPanel>
                  </StackPanel></Grid>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Latitude}"/>
                  <TextBox x:Name="LatitudeInput" Text="12.1" Width="96" HorizontalAlignment="Left"
                           TextChanged="Latitude_Changed" ToolTip="{DynamicResource RenderPanel.LatitudeHint}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <CheckBox x:Name="RenderClayCheck" Style="{StaticResource PanelCheck}" IsChecked="False" Margin="0"
                            Content="{DynamicResource View3D.Clay}" ToolTip="{DynamicResource RenderPanel.ClayHint}"
                            Checked="ClayMode_Changed" Unchecked="ClayMode_Changed"/>
                  <CheckBox x:Name="HazeCheck" Style="{StaticResource PanelCheck}" IsChecked="True"
                            Content="{DynamicResource RenderPanel.Haze}" Checked="Haze_Changed" Unchecked="Haze_Changed"/>
                  <CheckBox x:Name="ArtificialLightsCheck" Style="{StaticResource PanelCheck}" IsChecked="True"
                            Content="{DynamicResource RenderPanel.ArtificialLights}" Checked="Lights_Changed" Unchecked="Lights_Changed"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Exposure, picture style and effects -->
        <TabItem>
          <TabItem.Header>
            <StackPanel><TextBlock Style="{StaticResource TabIcon}" Text="&#xEB9F;"/>
              <TextBlock Style="{StaticResource TabText}" Text="{DynamicResource RenderPanel.Image}"/></StackPanel>
          </TabItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,8,0,4">
              <!-- Effect stack: the finishing effects in use, each with an eye to switch it off and its own settings. -->
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="FX" Style="{StaticResource PanelTitle}" Margin="0" VerticalAlignment="Center"/>
                    <Button x:Name="AddFxButton" Grid.Column="1" Click="AddFx_Click" Style="{StaticResource ViewportToolButton}" Padding="12,6" MinHeight="32"
                            ToolTip="Agregar un efecto a la imagen">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="FX" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="FxMenuButton" Grid.Column="2" Click="FxMenu_Click" Style="{StaticResource ViewportToolButton}" Padding="9,6" MinHeight="32"
                            Content="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="Guardar o cargar un estilo de efectos"/>
                  </Grid>
                  <StackPanel x:Name="FxStackList" Margin="0,10,0,0"/>
                  <TextBlock x:Name="FxEmptyHint" Style="{StaticResource PanelHint}" Margin="0,8,0,0"
                             Text="Sin efectos de acabado. Pulsa «FX» para agregar el primero."/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Image}"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Style}" Margin="0,4,0,4"/>
                  <ComboBox x:Name="StylePicker" SelectionChanged="Style_Changed" ToolTip="{DynamicResource RenderPanel.StyleHint}"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Margin="0,9,0,4" Text="Filtro de color fotográfico (LUT)"/>
                  <ComboBox x:Name="LutPicker" SelectionChanged="Lut_Changed"
                            ToolTip="Biblioteca de filtros integrada, comparable al flujo de gradación profesional; archivos .cube propios."/>
