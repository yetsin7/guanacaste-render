                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Tint}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=TintSlider, StringFormat={}{0:+0.00;-0.00;0}}"/>
                    <Slider x:Name="TintSlider" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Glare}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=GlareSlider, StringFormat={}{0:0%}}"/>
