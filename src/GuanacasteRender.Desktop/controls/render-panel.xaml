                    <Button Content="Importar .cube…" Padding="9,4" Margin="0,0,6,0" Click="LutLoad_Click"/>
                    <Button Content="Quitar filtro" Padding="9,4" Click="LutClear_Click"/>
                  </WrapPanel>
                  <TextBlock x:Name="LutNameText" Style="{StaticResource PanelHint}" Text="LUT desactivado" Margin="0,2,0,5"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="Intensidad del filtro"/>
