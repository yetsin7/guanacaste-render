                    <Slider x:Name="SharpenSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Aberration}"/>
