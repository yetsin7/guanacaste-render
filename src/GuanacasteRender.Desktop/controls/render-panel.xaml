                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=TiltShiftSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="TiltShiftSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Render.Camera.TiltShiftPosition}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=TiltShiftPositionSlider, StringFormat={}{0:+0.00;-0.00;0}}"/>
                    <Slider x:Name="TiltShiftPositionSlider" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                  <Button x:Name="FireButton" Content="{DynamicResource Render.Fire.Open}" Margin="0,12,0,0" Padding="10,5" HorizontalAlignment="Left"
                          Click="Fire_Click"/>
                  <CheckBox x:Name="OceanCheck" Style="{StaticResource PanelCheck}" IsChecked="False" Margin="0,12,0,0"
                            Content="{DynamicResource Render.Ocean.Use}" Checked="Ocean_Changed" Unchecked="Ocean_Changed"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Render.Ocean.Level}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=OceanLevelSlider, StringFormat={}{0:0.0} m}"/>
                    <Slider x:Name="OceanLevelSlider" Minimum="-5" Maximum="5" Value="-0.5" TickFrequency="0.1"
                            IsSnapToTickEnabled="True" ValueChanged="Ocean_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Render.Ocean.Waves}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=OceanWavesSlider, StringFormat={}{0:0.0}×}"/>
                    <Slider x:Name="OceanWavesSlider" Minimum="0.3" Maximum="3" Value="1" TickFrequency="0.1"
                            IsSnapToTickEnabled="True" ValueChanged="Ocean_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Render.Ocean.Tint}"/>
                  <ComboBox x:Name="OceanTintPicker" SelectionChanged="Ocean_SelectionChanged"/>
                  <CheckBox x:Name="LayersAnimationCheck" Style="{StaticResource PanelCheck}" IsChecked="False" Margin="0,12,0,0"
                            Content="{DynamicResource Render.Layers.Use}" Checked="Layers_Changed" Unchecked="Layers_Changed"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Margin="0,12,0,0" Text="{DynamicResource RenderPanel.HighlightMaterial}"/>
                  <ComboBox x:Name="HighlightPicker" SelectedIndex="0" SelectionChanged="Highlight_Changed"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.HighlightDim}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=HighlightDimSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="HighlightDimSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Finish_SliderChanged"/>
                  </DockPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Camera, navigation and the walkthrough -->
        <TabItem>
          <TabItem.Header>
            <StackPanel><TextBlock Style="{StaticResource TabIcon}" Text="&#xE722;"/>
              <TextBlock Style="{StaticResource TabText}" Text="{DynamicResource RenderPanel.CameraTab}"/></StackPanel>
          </TabItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,8,0,4">
              <!-- The photographic lens: focal length, level, shift and focus, as in Lumion's photo camera. -->
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Lens}"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.FocalLength}"/>
                  <DockPanel>
                    <TextBlock x:Name="FocalValueText" Style="{StaticResource SliderValue}" Text="29 mm"/>
                    <Slider x:Name="FocalSlider" Minimum="10" Maximum="135" Value="29" SmallChange="1" LargeChange="5"
                            ValueChanged="FocalSlider_Changed"/>
                  </DockPanel>
                  <TextBlock x:Name="FieldOfViewText" Style="{StaticResource PanelHint}" Margin="0,2,0,6"/>
                  <WrapPanel x:Name="FocalPresets"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Roll}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=RollSlider, StringFormat={}{0:0.0}°}"/>
                    <Slider x:Name="RollSlider" Minimum="-45" Maximum="45" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True"
                            ValueChanged="Lens_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.ShiftY}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=ShiftYSlider, StringFormat={}{0:0} %}"/>
                    <Slider x:Name="ShiftYSlider" Minimum="-50" Maximum="50" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="Lens_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.ShiftX}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=ShiftXSlider, StringFormat={}{0:0} %}"/>
                    <Slider x:Name="ShiftXSlider" Minimum="-50" Maximum="50" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="Lens_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.FocusDistance}"/>
                  <DockPanel>
                    <TextBlock x:Name="FocusValueText" Style="{StaticResource SliderValue}" Text="Auto"/>
                    <Slider x:Name="FocusSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True"
                            ValueChanged="Lens_SliderChanged"/>
                  </DockPanel>
                  <Button Content="{DynamicResource RenderPanel.PickFocus}" Click="PickFocus_Click" x:Name="PickFocusButton"
                          Style="{StaticResource PanelButton}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                  <CheckBox x:Name="ApertureCheck" Style="{StaticResource PanelCheck}" IsChecked="False"
                            Content="{DynamicResource RenderPanel.ApertureOn}" Checked="Aperture_Changed" Unchecked="Aperture_Changed"/>
                  <DockPanel x:Name="AperturePanel" Visibility="Collapsed">
                    <TextBlock x:Name="ApertureValueText" Style="{StaticResource SliderValue}" Text="f/2.8"/>
                    <Slider x:Name="ApertureSlider" Minimum="1.2" Maximum="22" Value="2.8" TickFrequency="0.1" IsSnapToTickEnabled="True"
                            ValueChanged="Lens_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelHint}" Text="{DynamicResource RenderPanel.LensHint}" Margin="0,2,0,0"/>
                  <Button Content="{DynamicResource RenderPanel.ResetLens}" Click="ResetLens_Click"
                          Style="{StaticResource PanelButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Navigation}"/>
                  <CheckBox x:Name="VerticalsCheck" Style="{StaticResource PanelCheck}" IsChecked="True" Margin="0,4,0,0"
                            Content="{DynamicResource RenderPanel.Verticals}" Checked="Camera_Changed" Unchecked="Camera_Changed"/>
                  <CheckBox x:Name="CollisionCheck" Style="{StaticResource PanelCheck}" IsChecked="False"
                            Content="{DynamicResource RenderPanel.Collisions}" ToolTip="{DynamicResource RenderPanel.CollisionsHint}"
                            Checked="Collision_Changed" Unchecked="Collision_Changed"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.DepthOfField}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=DepthOfFieldSlider, StringFormat={}{0:0} %}"/>
                    <Slider x:Name="DepthOfFieldSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="5"
                            IsSnapToTickEnabled="True" ValueChanged="Camera_SliderChanged"/>
                  </DockPanel>
                  <Button Content="{DynamicResource RenderPanel.FrameAll}" Click="FrameAll_Click"
                          Style="{StaticResource PanelButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Expander x:Name="TourExpander" Foreground="{DynamicResource PrimaryTextBrush}" IsExpanded="True">
                  <Expander.Header>
                    <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Tour}" Margin="0"/>
                  </Expander.Header>
                  <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource PanelHint}" Text="{DynamicResource RenderPanel.TourHint}" Margin="0,0,0,8"/>
                    <ListBox x:Name="MarksList" Height="150" SelectionChanged="MarksList_SelectionChanged"/>
                    <WrapPanel Margin="0,10,0,0">
                      <Button Content="{DynamicResource RenderPanel.AddMark}" Click="AddMark_Click" Style="{StaticResource PanelButton}"/>
                      <Button x:Name="GoToMarkButton" Content="{DynamicResource RenderPanel.GoToMark}" Click="GoToMark_Click"
                              Style="{StaticResource PanelButton}" IsEnabled="False"/>
                      <Button x:Name="RemoveMarkButton" Content="{DynamicResource RenderPanel.RemoveMark}" Click="RemoveMark_Click"
                              Style="{StaticResource PanelButton}" IsEnabled="False"/>
                    </WrapPanel>
                    <Grid Margin="0,2,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.MarkSeconds}" Margin="0,4,0,4"/>
                        <TextBox x:Name="MarkSecondsInput" Text="4" Width="80" HorizontalAlignment="Left" LostFocus="MarkSeconds_LostFocus"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Fps}" Margin="0,4,0,4"/>
                        <ComboBox x:Name="FpsPicker" SelectedIndex="1" Width="96" HorizontalAlignment="Left">
                          <ComboBoxItem Content="24" Tag="24"/><ComboBoxItem Content="30" Tag="30"/><ComboBoxItem Content="60" Tag="60"/>
                        </ComboBox>
                        <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.KeyFps}" Margin="0,8,0,4"/>
                        <ComboBox x:Name="KeyFpsPicker" SelectedIndex="2" Width="170" HorizontalAlignment="Left"
                                  ToolTip="{DynamicResource RenderPanel.KeyFpsHint}">
                          <ComboBoxItem Content="{DynamicResource RenderPanel.KeyFpsAll}" Tag="0"/>
                          <ComboBoxItem Content="10" Tag="10"/><ComboBoxItem Content="6" Tag="6"/><ComboBoxItem Content="4" Tag="4"/>
                        </ComboBox>
                        <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.MovieLighting}" Margin="0,8,0,4"/>
                        <ComboBox x:Name="MovieLightingPicker" SelectedIndex="0" Width="170" HorizontalAlignment="Left"
                                  ToolTip="{DynamicResource RenderPanel.MovieLightingHint}">
                          <ComboBoxItem Content="{DynamicResource RenderPanel.MovieLightingFast}" Tag="2"/>
                          <ComboBoxItem Content="{DynamicResource RenderPanel.MovieLightingFull}" Tag="1"/>
                        </ComboBox>
                      </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                      <Button x:Name="PlayTourButton" Content="{DynamicResource RenderPanel.PlayTour}" Click="PlayTour_Click"
                              Style="{StaticResource PanelButton}"/>
                      <Button x:Name="RenderTourButton" Content="{DynamicResource RenderPanel.RenderVideo}" Click="RenderTour_Click"
                              Style="{StaticResource PanelButton}"/>
                    </WrapPanel>
                  </StackPanel>
                </Expander>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Materials of each surface -->
        <TabItem>
          <TabItem.Header>
            <StackPanel><TextBlock Style="{StaticResource TabIcon}" Text="&#xE790;"/>
              <TextBlock Style="{StaticResource TabText}" Text="{DynamicResource RenderPanel.Materials}"/></StackPanel>
          </TabItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,8,0,4">
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>


                  <TextBlock x:Name="MaterialScopeInfo" Style="{StaticResource PanelHint}" Text="Material general por categoría"/>
                  <Button x:Name="MaterialScopeReset" Visibility="Collapsed" Content="Volver a materiales generales"
                          HorizontalAlignment="Left" Margin="0,6,0,3" Padding="8,4" Click="MaterialScopeReset_Click"/>

                  <UniformGrid Columns="2" Margin="0,12,0,8">
                    <Button x:Name="MaterialLibraryTab" Content="▦  Biblioteca" Tag="library" Click="MaterialView_Click" Padding="10,8" Background="#345F91"/>
                    <Button x:Name="MaterialSettingsTab" Content="✎  Ajustes" Tag="settings" Click="MaterialView_Click" Padding="10,8"/>
                  </UniformGrid>
                  <StackPanel x:Name="MaterialSettingsHost" Visibility="Collapsed">
                      <Border x:Name="GalleryAppearanceEditor" Background="#222428"
                              BorderBrush="#406075" BorderThickness="1" CornerRadius="0"
                              Padding="12" Margin="0,15,0,0">
                        <StackPanel>
                          <TextBlock Text="{DynamicResource RenderGallery.Appearance}" FontWeight="SemiBold"
                                     Foreground="White" FontSize="14" Margin="0,0,0,8"/>
                          <TextBlock x:Name="GalleryAppearanceName" Text="{DynamicResource RenderGallery.NoMaterial}"
                                     TextWrapping="Wrap" Foreground="#B8B8BD" FontSize="11" Margin="0,0,0,8"/>
                          <!-- A stylised ball that answers the sliders at once; the real result is in the render. -->
                          <Image x:Name="GalleryPreviewSphere" Width="72" Height="72" Margin="0,2,0,12" HorizontalAlignment="Center"
                                 RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Vista previa del material (aproximada)"/>
                          <DockPanel>
                            <TextBlock x:Name="GalleryRoughnessValue" DockPanel.Dock="Right" Foreground="#62B5F6"
                                       Text="0.70" Width="45" TextAlignment="Right"/>
                            <TextBlock Text="{DynamicResource RenderGallery.Roughness}" Foreground="#EDF5FA"/>
                          </DockPanel>
                          <Slider x:Name="GalleryRoughnessSlider" Minimum="0.02" Maximum="1" Value="0.7"
                                  SmallChange="0.01" TickFrequency="0.01" Margin="0,2,0,10"
                                  ValueChanged="GalleryAppearanceValue_Changed"/>
                          <DockPanel>
                            <TextBlock x:Name="GalleryMetallicValue" DockPanel.Dock="Right" Foreground="#62B5F6"
                                       Text="0.00" Width="45" TextAlignment="Right"/>
                            <TextBlock Text="{DynamicResource RenderGallery.Metallic}" Foreground="#EDF5FA"/>
                          </DockPanel>
                          <Slider x:Name="GalleryMetallicSlider" Minimum="0" Maximum="1" Value="0"
                                  SmallChange="0.01" TickFrequency="0.01" Margin="0,2,0,10"
                                  ValueChanged="GalleryAppearanceValue_Changed"/>
                          <DockPanel>
                            <TextBlock x:Name="GalleryReliefValue" DockPanel.Dock="Right" Foreground="#62B5F6"
                                       Text="0.30" Width="45" TextAlignment="Right"/>
                            <TextBlock Text="{DynamicResource RenderGallery.Relief}" Foreground="#EDF5FA"/>
                          </DockPanel>
                          <Slider x:Name="GalleryReliefSlider" Minimum="0" Maximum="1" Value="0.3"
                                  SmallChange="0.01" TickFrequency="0.01" Margin="0,2,0,8"
                                  ValueChanged="GalleryAppearanceValue_Changed"/>
                          <DockPanel>
                            <TextBlock x:Name="GalleryScaleValue" DockPanel.Dock="Right" Foreground="#62B5F6"
                                       Text="1.00 m" Width="55" TextAlignment="Right"/>
                            <TextBlock Text="Escala de mapa" Foreground="#EDF5FA"
                                       ToolTip="Metros que cubre una copia de la imagen."/>
                          </DockPanel>
                          <Slider x:Name="GalleryScaleSlider" Minimum="0.05" Maximum="10" Value="1"
                                  SmallChange="0.05" TickFrequency="0.05" Margin="0,2,0,10"
                                  ValueChanged="GalleryAppearanceValue_Changed"/>
                          <TextBlock Text="Colorización" Foreground="#EDF5FA" Margin="0,0,0,6"
                                     ToolTip="Tiñe el material sin cambiar su imagen."/>
                          <WrapPanel x:Name="GalleryTintSwatches" Margin="0,0,0,8"/>
                          <WrapPanel Margin="0,4,0,8">
                            <Button x:Name="GalleryApplyAppearanceButton"
                                    Content="{DynamicResource RenderGallery.Apply}"
                                    Click="GalleryApplyAppearance_Click" Padding="11,7"
                                    Background="{StaticResource StudioAccentBrush}" Foreground="White" Margin="0,0,7,5"/>
                            <Button x:Name="GalleryResetAppearanceButton"
                                    Content="{DynamicResource RenderGallery.Reset}"
                                    Click="GalleryResetAppearance_Click" Padding="11,7" Margin="0,0,0,5"/>
                          </WrapPanel>
                          <TextBlock Text="{DynamicResource RenderGallery.MapChannels}" Foreground="#EDF5FA"
                                     FontWeight="SemiBold" Margin="0,4,0,6"/>
                          <WrapPanel x:Name="GalleryPbrMapCards" HorizontalAlignment="Center"/>
                          <TextBlock Text="{DynamicResource RenderGallery.MapHint}" Foreground="#8FA8BC"
                                     TextWrapping="Wrap" FontSize="10.5" Margin="0,6,0,0"/>
                        </StackPanel>
                      </Border>
                  </StackPanel>
                  <!-- Eight thumbnails per page, generated off the UI thread only when expanded. -->
                  <Expander x:Name="GalleryExpander" IsExpanded="True" Margin="0,4,0,8"
                            Expanded="GalleryExpanded" Collapsed="GalleryCollapsed"
                            Foreground="#F0F6FB" Background="#222428">
                    <Expander.Template><ControlTemplate TargetType="Expander"><ContentPresenter Content="{TemplateBinding Content}"/></ControlTemplate></Expander.Template>
                    <StackPanel Margin="0,0,0,4">

                      <ComboBox x:Name="GalleryTargetPicker" SelectionChanged="GalleryFilter_Changed"
                                ToolTip="{DynamicResource RenderGallery.TargetHint}"/>

                      <ComboBox x:Name="GalleryGroupPicker" Margin="0,6,0,0" SelectedIndex="0" SelectionChanged="GalleryFilter_Changed">
                        <ComboBoxItem Content="{DynamicResource RenderGallery.Presets}" Tag="presets"/>
                        <ComboBoxItem Content="{DynamicResource RenderGallery.Trees}" Tag="trees"/>
                        <ComboBoxItem Content="{DynamicResource RenderGallery.Bark}" Tag="bark"/>
                        <ComboBoxItem Content="{DynamicResource RenderGallery.Foliage}" Tag="foliage"/>
                        <ComboBoxItem Content="{DynamicResource RenderGallery.Other}" Tag="other"/>
                        <ComboBoxItem Content="{DynamicResource RenderGallery.Pbr}" Tag="pbr"/>
                        <ComboBoxItem Content="{DynamicResource RenderGallery.All}" Tag="all"/>
                      </ComboBox>

                      <TextBox x:Name="GallerySearch" Style="{StaticResource StudioSearch}" Tag="Buscar materiales" Margin="0,9,0,10"
                               TextChanged="GalleryFilter_Changed"
                               ToolTip="{DynamicResource RenderGallery.SearchHint}"/>
                      <WrapPanel x:Name="GalleryPresetCategories" Margin="0,0,0,10" HorizontalAlignment="Center"/><WrapPanel x:Name="GalleryTiles" HorizontalAlignment="Center"/>
                      <TextBlock x:Name="GalleryFeedback" Foreground="#9CB5C8" TextWrapping="Wrap"
                                 FontSize="11" Margin="0,6,0,0"/>
                      <DockPanel Margin="0,10,0,0">
                        <Button x:Name="GalleryPreviousButton" DockPanel.Dock="Left"
                                Content="‹" MinWidth="42" Padding="10,5"
                                Click="GalleryPrevious_Click"/>
                        <Button x:Name="GalleryNextButton" DockPanel.Dock="Right"
                                Content="›" MinWidth="42" Padding="10,5"
                                Click="GalleryNext_Click"/>
                        <TextBlock x:Name="GalleryPageText" HorizontalAlignment="Center" TextAlignment="Center"
                                   VerticalAlignment="Center" Foreground="#DBE7F3" FontSize="12"/>
                      </DockPanel>

                    </StackPanel>
                  </Expander>
                                    <Button x:Name="MaterialPickerButton" Content="Ampliar biblioteca ↗" Margin="0,6,0,0" Padding="8,4"
                          HorizontalAlignment="Stretch" FontWeight="SemiBold" Click="MaterialPicker_Click"
                          ToolTip="Abre la biblioteca grande: esferas agrupadas por tipo, un clic aplica el material a la superficie elegida"/>
                  <Button x:Name="GalleryImportPbrButton" Content="+ Importar material PBR"
                              Click="GalleryImportPbr_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                              Padding="8,4" Background="#26282B" Foreground="#F5F9FC" BorderBrush="#4B7280"/>
                  <CheckBox x:Name="StoneDetailCheck" Margin="0,8,0,4" IsChecked="False"
                            Content="Relieve geométrico en piedra natural"
                            ToolTip="Añade microgeometría auténtica solo al render de muros de piedra; hasta 80 000 triángulos adicionales. Desactivar para máquinas lentas."
                            Checked="StoneDetail_Changed" Unchecked="StoneDetail_Changed"/>
                  <TextBox Visibility="Collapsed" x:Name="MaterialSearch" Margin="0,10,0,8" ToolTip="Buscar materiales por nombre, familia o identificador, con o sin tildes. Abre el selector para ver los resultados."/>
                  <Expander Header="Materiales por superficie y mapas PBR" Foreground="#D6DFEB" Margin="0,10,0,0"><StackPanel x:Name="MaterialRows"/></Expander>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Quality, size and computer resources -->
        <TabItem>
          <TabItem.Header>
            <StackPanel><TextBlock Style="{StaticResource TabIcon}" Text="&#xE9E9;"/>
              <TextBlock Style="{StaticResource TabText}" Text="{DynamicResource RenderPanel.QualityTab}"/></StackPanel>
          </TabItem.Header>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,8,0,4">
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Quality}"/>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.QualityLabel}" Margin="0,4,0,4"/>
                  <ComboBox x:Name="QualityPicker" SelectedIndex="0" SelectionChanged="Quality_Changed">
                    <ComboBoxItem Content="{DynamicResource RenderPanel.Auto}" Tag="Auto"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.Draft}" Tag="Draft"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.Standard}" Tag="Standard"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.High}" Tag="High"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.Final}" Tag="Final"/>
                  </ComboBox>
                   <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.Size}"/>
                   <ComboBox x:Name="SizePicker" SelectedIndex="0" SelectionChanged="SizePicker_SelectionChanged" Visibility="Collapsed">
                    <ComboBoxItem Content="{DynamicResource RenderPanel.SizeView}" Tag="0x0"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.SizeHd}" Tag="1280x720"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.SizeFullHd}" Tag="1920x1080"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.SizeQhd}" Tag="2560x1440"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.SizeUhd}" Tag="3840x2160"/>
                  </ComboBox>
                   <UniformGrid x:Name="OutputPresetGrid" Columns="2" Margin="-3,0,-3,4" Loaded="OutputPresetGrid_Loaded">
                     <Button Tag="0x0" Click="OutputPreset_Click" Style="{StaticResource OutputPresetTile}"
                             Content="{DynamicResource RenderPanel.SizeView}"/>
                     <Button Tag="1280x720" Click="OutputPreset_Click" Style="{StaticResource OutputPresetTile}"
                             Content="{DynamicResource RenderPanel.SizeHd}"/>
                     <Button Tag="1920x1080" Click="OutputPreset_Click" Style="{StaticResource OutputPresetTile}"
                             Content="{DynamicResource RenderPanel.SizeFullHd}"/>
                     <Button Tag="2560x1440" Click="OutputPreset_Click" Style="{StaticResource OutputPresetTile}"
                             Content="{DynamicResource RenderPanel.SizeQhd}"/>
                     <Button Tag="3840x2160" Click="OutputPreset_Click" Style="{StaticResource OutputPresetTile}"
                             Content="{DynamicResource RenderPanel.SizeUhd}"/>
                   </UniformGrid>
                  <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource RenderPanel.BucketSize}" Margin="0,12,0,4"/>
                  <ComboBox x:Name="BucketSizePicker" SelectedIndex="0" ToolTip="{DynamicResource RenderPanel.BucketSizeHint}">
                    <ComboBoxItem Content="{DynamicResource RenderPanel.BucketAuto}" Tag="0"/>
                    <ComboBoxItem Content="8 × 8 px" Tag="8"/>
                    <ComboBoxItem Content="16 × 16 px" Tag="16"/>
                    <ComboBoxItem Content="32 × 32 px" Tag="32"/>
                    <ComboBoxItem Content="64 × 64 px" Tag="64"/>
                    <ComboBoxItem Content="128 × 128 px" Tag="128"/>
                  </ComboBox>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource RenderPanel.Resources}"/>
                  <ComboBox x:Name="ResourcePicker" SelectedIndex="1" SelectionChanged="Quality_Changed" Margin="0,4,0,0">
                    <ComboBoxItem Content="{DynamicResource RenderPanel.Eco}" Tag="Eco"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.Balanced}" Tag="Balanced"/>
                    <ComboBoxItem Content="{DynamicResource RenderPanel.Maximum}" Tag="Maximum"/>
                  </ComboBox>
                  <TextBlock x:Name="MemoryText" Style="{StaticResource PanelHint}" Margin="0,10,0,0"/>
                  <DockPanel Margin="0,10,0,0">
                    <Button x:Name="RecalibrateButton" DockPanel.Dock="Right" Padding="12,5" MinHeight="30"
                            Content="{DynamicResource RenderPanel.Recalibrate}" ToolTip="{DynamicResource RenderPanel.RecalibrateHint}"
                            Click="Recalibrate_Click"/>
                    <TextBlock x:Name="HardwareText" Style="{StaticResource PanelHint}" VerticalAlignment="Center" Margin="0,0,10,0"
                               Text="{DynamicResource RenderPanel.Calibrating}"/>
                  </DockPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      </DockPanel>
    </Grid>

    <!-- Drag to give the settings or the picture more room. -->
    <GridSplitter x:Name="SettingsSplitter" Grid.Row="1" Grid.Column="2" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                  Background="{DynamicResource PanelBorderBrush}" Cursor="SizeWE" Focusable="False"/>

    <DockPanel Grid.Row="1" Grid.Column="3">
      <DockPanel DockPanel.Dock="Top" Background="#1B1C1F" LastChildFill="True">
      <Button x:Name="NavigationHelpButton" Content="?" Click="NavigationHelp_Click" DockPanel.Dock="Right" Width="34" Height="34" Margin="4,0,10,0" ToolTip="Ayuda de navegación"/>
      <Button x:Name="CopyCurrentViewButton" Content="Copiar vista" Click="CopyCurrentView_Click"
              DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0"
              Padding="14,9" MinHeight="38" FontWeight="SemiBold"
              Background="#2A3543" Foreground="#DDE9F7" BorderBrush="#42546A"
              ToolTip="{DynamicResource RenderPanel.CopyViewForAiHint}"/>
                <ContentControl x:Name="OutputModeHost" Visibility="Collapsed"/>
        <TextBlock x:Name="StudioWorkspaceHeading" Text="Foto · cámaras y efectos" Foreground="#CDD1D7" Margin="16,0" VerticalAlignment="Center"/>
      </DockPanel>
    <Grid x:Name="ImageHost" ClipToBounds="True" SizeChanged="ImageHost_SizeChanged"
          AllowDrop="True" DragOver="MaterialDragOver" Drop="MaterialDrop">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#303238" Offset="0"/><GradientStop Color="#191A1D" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>
      <Viewport3D x:Name="InteractiveViewport" IsHitTestVisible="False" ClipToBounds="True"/>
      <!-- A still of the viewport with the active style and filters applied; hidden the moment the camera moves. -->
      <Image x:Name="StyledPreviewImage" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed"
             RenderOptions.BitmapScalingMode="HighQuality"/>
      <Border x:Name="FinalImageBorder" Visibility="Collapsed" Margin="30,22,30,176" Background="#111113" BorderBrush="#45454A" BorderThickness="1" CornerRadius="2" Padding="8">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="5" Opacity="0.42"/></Border.Effect>
        <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Focusable="False"/>
      </Border>
      <Canvas x:Name="SelectionOverlay" IsHitTestVisible="False" ClipToBounds="True"/>
      <Canvas x:Name="TransformGizmo" ClipToBounds="True"/>

      <!-- Lightweight sampled telemetry. GPU shows renderer usage (zero for the current CPU backend). -->
      <Border x:Name="RenderTelemetryPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
              Background="#DD1E293B" BorderBrush="#445B718B" BorderThickness="1" CornerRadius="0" Padding="12,10"
              Visibility="Collapsed" IsHitTestVisible="False">
        <StackPanel Width="267">
          <TextBlock Text="{DynamicResource RenderPanel.Telemetry}" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="CPU" Foreground="White" VerticalAlignment="Center"/>
            <Canvas Grid.Column="1" Width="120" Height="24" ClipToBounds="True">
              <Polyline x:Name="CpuLine" Stroke="#E3EDF0" StrokeThickness="1.8" StrokeLineJoin="Round"/>
            </Canvas>
            <TextBlock x:Name="CpuUsageText" Grid.Column="2" Foreground="White" Text="—" TextAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
          </Grid>
          <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="RAM" Foreground="White" VerticalAlignment="Center"/>
            <Canvas Grid.Column="1" Width="120" Height="24" ClipToBounds="True">
              <Polyline x:Name="RamLine" Stroke="#93B8FC" StrokeThickness="1.8" StrokeLineJoin="Round"/>
            </Canvas>
            <TextBlock x:Name="RamUsageText" Grid.Column="2" Foreground="White" Text="—" TextAlignment="Right" VerticalAlignment="Center" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="GPU" Foreground="White" VerticalAlignment="Center"/>
            <Canvas Grid.Column="1" Width="120" Height="24" ClipToBounds="True">
              <Polyline x:Name="GpuLine" Stroke="#F4B76D" StrokeThickness="1.8" StrokeLineJoin="Round"/>
            </Canvas>
            <TextBlock Grid.Column="2" Foreground="#D7E0ED" Text="0 % GRE" TextAlignment="Right" VerticalAlignment="Center" FontSize="10.5"/>
          </Grid>
          <TextBlock Text="{DynamicResource RenderPanel.GpuCpuBackend}" Foreground="#BBC9D9" TextWrapping="Wrap" FontSize="10" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
      <Button x:Name="SceneInspectorButton" Content="☷  Escena" Click="SceneInspector_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,16,0,0" Padding="14,9" Style="{StaticResource ViewportToolButton}"/>
      <Border x:Name="SceneInspector" Visibility="Collapsed" Panel.ZIndex="40" Width="330" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="18,60,0,246" Background="#202124" BorderBrush="#4B505A" BorderThickness="1" Padding="14" CornerRadius="5">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="✕" Click="SceneInspector_Click" Padding="6,2" ToolTip="Cerrar inspector"/>
            <TextBlock Text="Inspector de escena" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBox x:Name="SceneSearch" Style="{StaticResource StudioSearch}" Tag="Buscar en la escena" DockPanel.Dock="Top" TextChanged="SceneSearch_Changed" Margin="0,0,0,8" ToolTip="Buscar objetos por nombre, categoría o nivel" AutomationProperties.Name="Buscar en la escena"/>
          <ComboBox x:Name="SceneCategoryFilter" DockPanel.Dock="Top" SelectionChanged="SceneCategoryFilter_Changed" Margin="0,0,0,8" AutomationProperties.Name="Filtrar categoría de escena"/>
          <TextBlock x:Name="SceneSummary" DockPanel.Dock="Bottom" Foreground="#ADB9C8" TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SceneItemsPanel"/></ScrollViewer>
        </DockPanel>
      </Border>
      <Border x:Name="StudioWelcome" Padding="36">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#18232F" Offset="0"/><GradientStop Color="#283D50" Offset="0.6"/><GradientStop Color="#17202A" Offset="1"/></LinearGradientBrush></Border.Background>
        <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,190">
          <TextBlock Text="GUANACASTE RENDER" FontSize="12" FontWeight="SemiBold" Foreground="#80CFFF" Margin="0,0,0,16"/>
          <TextBlock Text="De proyecto a imagen." FontSize="36" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
          <TextBlock Text="Abre un proyecto de Guanacaste o explora la casa de ejemplo. Ajusta materiales y luz, guarda tus cámaras y crea una imagen." TextWrapping="Wrap" Foreground="#BCC6D3" FontSize="14" LineHeight="22" Margin="0,12,0,20"/>
          <WrapPanel>
            <Button Content="Abrir proyecto" Tag="open" Click="SceneCommand_Click" Style="{StaticResource RenderPrimaryButton}" Padding="18,10" Margin="0,0,8,8"/>
            <Button x:Name="StudioSampleButton" Content="Explorar casa de ejemplo" Tag="sample" Click="SceneCommand_Click" Style="{StaticResource ViewportToolButton}" Margin="0,0,0,8"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border x:Name="SkyLibrary" Visibility="Collapsed" Panel.ZIndex="110" Margin="16" Background="#202124" Padding="18" CornerRadius="6">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="✕" Click="SkyLibraryClose_Click" Padding="10,5" ToolTip="Cerrar biblioteca de cielos"/>
            <StackPanel><TextBlock Text="Biblioteca de cielos" FontSize="21" Foreground="White" FontWeight="SemiBold"/>
              <TextBlock Text="Cielos procedurales · cada cielo ajusta luz, hora y nubes" Foreground="#ADB9C8" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
          </DockPanel>
          <TextBox x:Name="SkySearch" Style="{StaticResource StudioSearch}" Tag="Buscar cielos" DockPanel.Dock="Top" TextChanged="SkySearch_Changed" Margin="0,0,0,12" ToolTip="Buscar cielo por nombre" AutomationProperties.Name="Buscar cielo"/>
          <WrapPanel x:Name="SkyCategories" DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button Content="▦  Todos" Tag="all" Click="SkyCategory_Click" Style="{StaticResource WorkspaceModeButton}" Background="#345F91"/>
            <Button Content="☀  Día" Tag="day" Click="SkyCategory_Click" Style="{StaticResource WorkspaceModeButton}"/>
            <Button Content="◒  Amanecer / atardecer" Tag="sunset" Click="SkyCategory_Click" Style="{StaticResource WorkspaceModeButton}"/>
            <Button Content="☁  Nublado" Tag="clouds" Click="SkyCategory_Click" Style="{StaticResource WorkspaceModeButton}"/>
            <Button Content="☾  Noche" Tag="night" Click="SkyCategory_Click" Style="{StaticResource WorkspaceModeButton}"/>
          </WrapPanel>
          <TextBlock x:Name="SkyEmptyHint" DockPanel.Dock="Top" Text="No se encontraron cielos. Prueba otro nombre." Foreground="#ADB9C8" Visibility="Collapsed" Margin="0,0,0,12"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><UniformGrid x:Name="SkyTiles" Columns="3" VerticalAlignment="Top"/></ScrollViewer>
        </DockPanel>
      </Border>
      <!-- Effect picker: categories on the left, one tile per effect on the right, like Lumion's "Select Photo Effect". -->
      <Border x:Name="FxPicker" Visibility="Collapsed" PreviewKeyDown="FxPicker_KeyDown" KeyboardNavigation.TabNavigation="Cycle" Panel.ZIndex="100" Background="#242528" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <DockPanel>
          <Grid DockPanel.Dock="Top" Height="44" Background="#202124">
            <Button Click="FxPickerClose_Click" HorizontalAlignment="Left" Width="44" Background="Transparent" BorderThickness="0"
                    Content="&#xE72B;" Foreground="White" FontSize="19" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="Volver"/>
            <TextBlock Text="Seleccionar efecto de foto" Foreground="White" FontSize="17"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <DockPanel DockPanel.Dock="Top" Margin="12,0,12,8">
            <Label Content="_Buscar" Target="{Binding ElementName=FxSearch}" Foreground="White"/>
            <TextBox x:Name="FxSearch" Style="{StaticResource StudioSearch}" Tag="Buscar efectos" TextChanged="FxSearch_Changed" AutomationProperties.Name="Buscar efectos" ToolTip="Buscar en todas las categorías"/>
          </DockPanel>
          <ScrollViewer DockPanel.Dock="Left" Width="148" VerticalScrollBarVisibility="Auto" Background="#1C1D20">
            <StackPanel x:Name="FxCategoryList" Margin="4,1,2,0"/>

          </ScrollViewer>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#28282B">
            <UniformGrid x:Name="FxTiles" Columns="3" VerticalAlignment="Top"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Border x:Name="InteractiveHintCard" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="18,16,18,0" Padding="12,9" CornerRadius="0"
              Background="#DB202124" BorderBrush="#526F75" BorderThickness="1" IsHitTestVisible="False">
        <StackPanel>
          <TextBlock Text="{DynamicResource RenderPanel.InteractiveTitle}" Foreground="#D8F4EF" FontWeight="SemiBold" FontSize="12"/>
          <TextBlock x:Name="HintText" Text="Ratón: mirar y orbitar · WASD: volar · Q/E: altura · Mayús: rápido" Foreground="#B9CDD0" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
      </Border>
      <!-- The compact strip keeps scene actions reachable without covering the central viewport. -->
      <Border x:Name="SceneToolsBar" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="12,0,12,196" Padding="4"
              Background="#EE20262E" BorderBrush="#47616D" BorderThickness="1" CornerRadius="9" MaxWidth="660">
        <StackPanel>
          <DockPanel Margin="4,0,4,5">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
              <Button x:Name="CreateToolsTab" Content="Crear" Tag="create" Click="ToolGroup_Click" Style="{StaticResource WorkspaceModeButton}"/>
              <Button x:Name="EditToolsTab" Content="Editar" Tag="edit" Click="ToolGroup_Click" Style="{StaticResource WorkspaceModeButton}"/>
              <Button x:Name="ViewToolsTab" Content="Vista" Tag="view" Click="ToolGroup_Click" Style="{StaticResource WorkspaceModeButton}"/>
            </StackPanel>
            <TextBlock x:Name="SceneSelectionText" Text="Selecciona un objeto" Foreground="#B9C8D9" FontSize="12" Margin="12,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <UniformGrid x:Name="SceneToolItems" Columns="6">
            <Button CommandParameter="create" AutomationProperties.ItemType="Importar" Style="{StaticResource SceneToolButton}"
                    Content="&#xE8B5;" ToolTip="{DynamicResource RenderTool.ImportHint}"
                    AutomationProperties.Name="{DynamicResource RenderTool.ImportHint}" Tag="import" Click="SceneCommand_Click"/>
            <Button CommandParameter="create" AutomationProperties.ItemType="Vegetación" Style="{StaticResource SceneToolButton}" Click="SceneScatter_Click" ToolTip="{DynamicResource RenderTool.Vegetation}" AutomationProperties.Name="{DynamicResource RenderTool.Vegetation}" Content="&#xE8B7;"/>
            <Button CommandParameter="create" AutomationProperties.ItemType="Personas" Style="{StaticResource SceneToolButton}" Click="ScenePeople_Click" ToolTip="{DynamicResource RenderTool.People}" AutomationProperties.Name="{DynamicResource RenderTool.People}" Content="&#xE77B;"/>
            <Button CommandParameter="create" AutomationProperties.ItemType="Fuego" Style="{StaticResource SceneToolButton}" Click="Fire_Click" ToolTip="{DynamicResource RenderTool.Fire}" AutomationProperties.Name="{DynamicResource RenderTool.Fire}" Content="&#xE7E8;"/>
            <Button CommandParameter="create" AutomationProperties.ItemType="Material" Style="{StaticResource SceneToolButton}" Click="MaterialPicker_Click" ToolTip="{DynamicResource RenderTool.Material}" AutomationProperties.Name="{DynamicResource RenderTool.Material}" Content="&#xE790;"/>
            <Button CommandParameter="create" AutomationProperties.ItemType="Foto" Style="{StaticResource SceneToolButton}" Click="NewPhoto_Click" ToolTip="{DynamicResource RenderTool.Photo}" AutomationProperties.Name="{DynamicResource RenderTool.Photo}" Content="&#xE722;"/>
            <Button CommandParameter="view" AutomationProperties.ItemType="Cámara" Style="{StaticResource SceneToolButton}" Click="SceneCamera_Click" ToolTip="{DynamicResource RenderTool.Camera}" AutomationProperties.Name="{DynamicResource RenderTool.Camera}" Content="&#xE713;"/>
            <Button CommandParameter="view" AutomationProperties.ItemType="Órbita ←" Style="{StaticResource SceneToolButton}" x:Name="OrbitLeftButton" Click="OrbitLeft_Click" ToolTip="{DynamicResource RenderTool.OrbitLeft}" AutomationProperties.Name="{DynamicResource RenderTool.OrbitLeft}" Content="&#xE7AD;"/>
            <Button CommandParameter="view" AutomationProperties.ItemType="Órbita →" Style="{StaticResource SceneToolButton}" x:Name="OrbitRightButton" Click="OrbitRight_Click" ToolTip="{DynamicResource RenderTool.OrbitRight}" AutomationProperties.Name="{DynamicResource RenderTool.OrbitRight}" Content="&#xE7AC;"/>
            <Button CommandParameter="view" AutomationProperties.ItemType="Encuadrar" Style="{StaticResource SceneToolButton}" x:Name="FrameModelButton" Click="FrameModel_Click" ToolTip="{DynamicResource RenderTool.Frame}" AutomationProperties.Name="{DynamicResource RenderTool.Frame}" Content="&#xE8A3;"/>
            <Button CommandParameter="edit" AutomationProperties.ItemType="Girar" Style="{StaticResource SceneToolButton}" x:Name="RotateObjectButton" Tag="rotate" Click="RotateGizmo_Click" ToolTip="{DynamicResource RenderTool.Rotate}" AutomationProperties.Name="{DynamicResource RenderTool.Rotate}" Content="&#xE7AD;"/>
            <Button CommandParameter="edit" AutomationProperties.ItemType="Mover" x:Name="MoveGizmoButton" Style="{StaticResource SceneToolButton}" Click="MoveGizmo_Click" ToolTip="Mover objeto · arrastra sus ejes X, Y o Z" AutomationProperties.Name="Mover objeto" Content="&#xE759;"/>
            <Button CommandParameter="edit" AutomationProperties.ItemType="Duplicar" Style="{StaticResource SceneToolButton}" x:Name="DuplicateObjectButton" Tag="duplicate" Click="SceneCommand_Click" ToolTip="{DynamicResource RenderTool.Duplicate}" AutomationProperties.Name="{DynamicResource RenderTool.Duplicate}" Content="&#xE8A7;"/>
            <Button CommandParameter="edit" AutomationProperties.ItemType="Eliminar" Style="{StaticResource SceneToolButton}" x:Name="DeleteObjectButton" Tag="delete" Click="SceneCommand_Click" ToolTip="{DynamicResource RenderTool.Delete}" AutomationProperties.Name="{DynamicResource RenderTool.Delete}" Content="&#xE74D;"/>
            <Button CommandParameter="edit" AutomationProperties.ItemType="Deshacer" Style="{StaticResource SceneToolButton}" x:Name="UndoSceneButton" Tag="undo" Click="SceneCommand_Click" ToolTip="{DynamicResource RenderTool.Undo}" AutomationProperties.Name="{DynamicResource RenderTool.Undo}" Content="&#xE7A7;"/>
            <Button CommandParameter="edit" AutomationProperties.ItemType="Rehacer" x:Name="RedoSceneButton" Style="{StaticResource SceneToolButton}" Tag="redo" Click="SceneCommand_Click" ToolTip="Rehacer · Ctrl+Y" AutomationProperties.Name="Rehacer" Content="&#xE7A6;"/>
            <Button CommandParameter="view" AutomationProperties.ItemType="Efectos" Style="{StaticResource SceneToolButton}" x:Name="FxBarButton" Click="AddFx_Click" ToolTip="{DynamicResource RenderTool.Effects}" AutomationProperties.Name="{DynamicResource RenderTool.Effects}" Content="&#xE710;"/>
            <Button CommandParameter="view" AutomationProperties.ItemType="Ampliar" Style="{StaticResource SceneToolButton}" x:Name="TheaterButton" Click="Theater_Click" ToolTip="{DynamicResource RenderTool.Theater}" AutomationProperties.Name="{DynamicResource RenderTool.Theater}">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE740;"/><TextBlock x:Name="TheaterText" Visibility="Collapsed"/></StackPanel>
            </Button>
          </UniformGrid>
        </StackPanel>
      </Border>
      <!-- Photo strip: saved views with their own style and filters, rendered one by one or all at once. -->
      <Border x:Name="PhotoStrip" VerticalAlignment="Bottom" Margin="0,0,0,62" Height="124" Background="#F2212226"
              BorderBrush="#38505A" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="14,0,10,0" Width="126">
            <Button x:Name="NewPhotoButton" Click="NewPhoto_Click" Style="{StaticResource RenderPrimaryButton}" MinHeight="40"
                    ToolTip="Guarda la vista actual como una foto con sus propios estilos y filtros (Ctrl+1 … Ctrl+0)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Nueva foto" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <CheckBox x:Name="StylePreviewCheck" IsChecked="True" Margin="0,9,0,0" Foreground="#B8B8BD" FontSize="11.5"
                      Content="Ver estilo en vivo" Checked="StylePreview_Changed" Unchecked="StylePreview_Changed"
                      ToolTip="Muestra el estilo y los filtros sobre la vista cuando dejas de mover la cámara."/>
          </StackPanel>
          <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,2">
            <StackPanel x:Name="PhotoCards" Orientation="Horizontal" VerticalAlignment="Center"/>
          </ScrollViewer>
          <TextBlock x:Name="PhotoEmptyHint" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0"
                     Foreground="#919197" FontSize="12" TextWrapping="Wrap" MaxWidth="420" IsHitTestVisible="False"
                     Text="Navega hasta un buen encuadre y pulsa «Nueva foto». Cada foto guarda su cámara, estilo y filtros."/>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,16,0" Width="126">
            <Button x:Name="RenderPhotosButton" Click="RenderPhotos_Click" Style="{StaticResource RenderPrimaryButton}" MinHeight="44"
                    ToolTip="Renderiza una foto, varias o todas de una vez">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Renderizar…" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <TextBlock x:Name="PhotoCountText" Foreground="#919197" FontSize="11" Margin="0,7,0,0" TextAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
      <!-- Mode switch, movie timeline and panorama bar are built in render-panel-modes.cs. -->
      <Grid x:Name="ModeOverlayHost"/>
      <Border VerticalAlignment="Bottom" Background="#202124" BorderBrush="#38505A"
              BorderThickness="0,1,0,0" Padding="18,9">
        <DockPanel>
          <Button x:Name="RenderButton" DockPanel.Dock="Right" Click="RenderButton_Click" MinHeight="40" MinWidth="155"
                  Margin="14,0,0,0" FontSize="14" Style="{StaticResource RenderPrimaryButton}"
                  Content="{DynamicResource RenderPanel.Render}"/>
          <StackPanel x:Name="RenderProgressPanel" DockPanel.Dock="Right" Width="285" Margin="16,0,0,0"
                      Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ProgressBar x:Name="RenderProgress" Height="10" Minimum="0" Maximum="1" Foreground="#42C9B0"
                           AutomationProperties.Name="{DynamicResource RenderPanel.ProgressLabel}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Margin="10,0,0,0" Foreground="#EAF5F3" FontSize="12" FontWeight="SemiBold"
                         Text="{Binding Value, ElementName=RenderProgress, StringFormat={}{0:P0}}"
                         AutomationProperties.Name="{DynamicResource RenderPanel.ProgressLabel}"/>
            </Grid>
            <Grid Margin="0,5,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="RenderElapsedText" Text="00:00:00" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5"
                         ToolTip="{DynamicResource RenderPanel.ElapsedHint}"/>
              <TextBlock x:Name="RenderRemainingText" Grid.Column="1" Text="—" Foreground="{DynamicResource SecondaryTextBrush}"
                         FontSize="11" ToolTip="{DynamicResource RenderPanel.RemainingHint}"/>
            </Grid>
          </StackPanel>
          <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                     Foreground="{StaticResource StudioAccentBrush}" Margin="0,0,10,0"/>
          <TextBlock x:Name="StatusText" Foreground="#D6D6D9" FontSize="12"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{DynamicResource RenderPanel.Idle}"/>
        </DockPanel>
      </Border>
    </Grid>
    </DockPanel>
  </Grid>
</UserControl>
