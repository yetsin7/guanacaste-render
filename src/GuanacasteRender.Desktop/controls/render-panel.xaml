<UserControl x:Class="Guanacaste3D.Desktop.Controls.RenderPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="#1C1D20" Foreground="#EAF0F6" Focusable="False" FontSize="13">
  <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="studio-theme.xaml"/></ResourceDictionary.MergedDictionaries>
    <Style x:Key="PanelTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F5F5F6"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="PanelLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#C5C5C9"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,12,0,5"/>
    </Style>
    <Style x:Key="PanelHint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource StudioMutedTextBrush}"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="17"/>
    </Style>
    <Style x:Key="SliderValue" TargetType="TextBlock">
      <Setter Property="DockPanel.Dock" Value="Right"/><Setter Property="Width" Value="62"/>
      <Setter Property="Foreground" Value="#F1F5F9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Right"/>
    </Style>
    <Style x:Key="PanelCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#EAF0F5"/>
      <Setter Property="Margin" Value="0,9,0,0"/><Setter Property="FontSize" Value="13"/>
    </Style>
    <!-- The panel is dark: every plain control inside it needs light text and a dark face, or its caption vanishes. -->
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EAF0F5"/></Style>
    <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#EAF0F5"/></Style>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#34363B"/><Setter Property="Foreground" Value="#F2F6FA"/>
      <Setter Property="BorderBrush" Value="#4A6882"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid SnapsToDevicePixels="True">
          <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
          </Border>
          <!-- A translucent veil lightens any face colour on hover, so custom backgrounds keep their identity. -->
          <Border x:Name="Veil" CornerRadius="0" Background="White" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Veil" Property="Opacity" Value="0.14"/>
            <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#6AADE4"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#E3EDF0"/>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Veil" Property="Opacity" Value="0.24"/></Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.5"/>
            <Setter Property="Foreground" Value="#9FB2C3"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PanelButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Background" Value="#303237"/><Setter Property="Foreground" Value="#F2F6FA"/>
      <Setter Property="BorderBrush" Value="#46484F"/>
      <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,2,0,2"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid Background="#17181A" Height="24" SnapsToDevicePixels="True">
          <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#50545B"/></ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="4" Background="#93BDD9">
              <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}"/></ControlTemplate></Thumb.Template>
            </Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseRepeatButton>
          </Track>
          <Border x:Name="FocusFrame" BorderBrush="#93BDD9" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusFrame" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="#303237"/><Setter Property="Foreground" Value="#F2F6FA"/>
      <Setter Property="BorderBrush" Value="#46484F"/>
      <Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="6,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CaretBrush" Value="White"/><Setter Property="SelectionBrush" Value="#2E7D9A"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" SnapsToDevicePixels="True">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#6C97B8"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#E3EDF0"/></Trigger>
          <!-- A disabled field stays dark with readable grey-blue text instead of turning pale. -->
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="Frame" Property="Background" Value="#1A2633"/>
            <Setter Property="Foreground" Value="#8FA4B7"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="Background" Value="#1C1D20"/>
      <Setter Property="BorderBrush" Value="#344555"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="16,14"/><Setter Property="Margin" Value="12,0,12,12"/>
    </Style>
    <!-- Section tabs: an icon above a short name, with an accent bar under the open one. -->
    <Style x:Key="SectionTab" TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Chrome" Background="Transparent" Padding="4,9,4,7" Cursor="Hand">
              <Grid>
                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                <Border x:Name="Bar" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="10,0,10,-7"
                        Background="{DynamicResource AccentBrush}" Visibility="Hidden"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RibbonHoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TabIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="18"/><Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
    </Style>
    <Style x:Key="TabText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/><Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
    </Style>
    <Style x:Key="RenderRailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#1C1D20"/>
      <Setter Property="Foreground" Value="#DDEBF5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="52"/>
      <Setter Property="Height" Value="58"/>
      <Setter Property="Margin" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="4,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#2A2A2E"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ImageToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style x:Key="ViewportToolButton" TargetType="Button">
      <Setter Property="Foreground" Value="#E7F1F3"/><Setter Property="Background" Value="#303339"/>
      <Setter Property="BorderBrush" Value="#484C54"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3,0"/>
      <Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#3E5572"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#293D57"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WorkspaceModeButton" TargetType="Button" BasedOn="{StaticResource ViewportToolButton}">
      <Setter Property="MinWidth" Value="66"/><Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="12,7"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="RenderPrimaryButton" TargetType="Button" BasedOn="{StaticResource ViewportToolButton}">
      <Setter Property="Background" Value="#345F91"/><Setter Property="BorderBrush" Value="#5686BC"/>
      <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="OutputPresetTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#343438"/>
      <Setter Property="BorderBrush" Value="#45454A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#F3F3F5"/>
      <Setter Property="MinHeight" Value="58"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SceneToolButton" TargetType="Button" BasedOn="{StaticResource ViewportToolButton}">
      <Setter Property="Width" Value="64"/><Setter Property="Height" Value="58"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="Margin" Value="1"/><Setter Property="Padding" Value="3"/><Setter Property="Background" Value="#292C32"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="17"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="#464C56" BorderThickness="1" Padding="{TemplateBinding Padding}">
          <StackPanel VerticalAlignment="Center"><ContentPresenter HorizontalAlignment="Center"/><TextBlock Text="{Binding Path=(AutomationProperties.ItemType), RelativeSource={RelativeSource TemplatedParent}}" FontFamily="Segoe UI" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#3C3C41"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#4688A4"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PreviewSwitch" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#E7F1F3"/><Setter Property="Background" Value="#303339"/>
      <Setter Property="BorderBrush" Value="#484C54"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,7"/><Setter Property="MinHeight" Value="34"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="SwitchChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchChrome" Property="Background" Value="#345F91"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchChrome" Property="BorderBrush" Value="#7BDCD0"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </ResourceDictionary></UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="54"/>
      <ColumnDefinition x:Name="SettingsColumn" Width="340" MinWidth="330" MaxWidth="760"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Row="0" Grid.ColumnSpan="4" Background="#191A1D" BorderBrush="#3D4149" BorderThickness="0,0,0,1" Padding="10,7">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="GUANACASTE  /  RENDER" FontSize="12" FontWeight="SemiBold" Foreground="#E3E8F0" VerticalAlignment="Center" Margin="5,0,24,0"/>
        <StackPanel x:Name="ProjectCommands" DockPanel.Dock="Left" Orientation="Horizontal">
          <Button x:Name="StudioOpenButton" Content="Abrir proyecto" Tag="open" Click="SceneCommand_Click" Style="{StaticResource ViewportToolButton}" ToolTip="Abrir un proyecto .g3d · Ctrl+O"/>
          <Button x:Name="StudioSaveButton" Content="Guardar" Tag="save" Click="SceneCommand_Click" Style="{StaticResource ViewportToolButton}" ToolTip="Guardar proyecto, materiales y cámaras · Ctrl+S"/>
          <Button Content="Guardar como…" Tag="save-as" Click="SceneCommand_Click" Style="{StaticResource ViewportToolButton}"/>
          <Button Content="Escena de ejemplo" Tag="sample" Click="SceneCommand_Click" Style="{StaticResource ViewportToolButton}"/>
        </StackPanel>
        <TextBlock x:Name="StudioProjectText" Foreground="#A8B3C2" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="18,0,8,0"/>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Grid.Column="0" Background="#191A1C" BorderBrush="#34363B" BorderThickness="0,0,1,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="2,10">
          <Button x:Name="StudioBuildModeButton" ToolTip="Escena" Tag="Build" Click="StudioMode_Click" Style="{StaticResource RenderRailButton}" Width="48" MinWidth="0" Height="64"><StackPanel><TextBlock Text="⌂" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="Escena" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="StudioPhotoModeButton" ToolTip="Foto" Tag="Photo" Click="StudioMode_Click" Style="{StaticResource RenderRailButton}" Width="48" MinWidth="0" Height="64"><StackPanel><TextBlock Text="◎" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="Foto" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="StudioMovieModeButton" ToolTip="Película" Tag="Movie" Click="StudioMode_Click" Style="{StaticResource RenderRailButton}" Width="48" MinWidth="0" Height="64"><StackPanel><TextBlock Text="▷" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="Película" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="StudioPanoramaModeButton" ToolTip="360°" Tag="Panorama" Click="StudioMode_Click" Style="{StaticResource RenderRailButton}" Width="48" MinWidth="0" Height="64"><StackPanel><TextBlock Text="◉" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="360°" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Button>
        </StackPanel></ScrollViewer></Border>
    <Grid Grid.Row="1" Grid.Column="1" Background="#1C1D20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="1" Background="#242528">
        <Border DockPanel.Dock="Top" Background="#202124" BorderBrush="#344555" BorderThickness="0,0,0,1" Padding="16,12">
          <StackPanel>
            <TextBlock Text="AJUSTES DE ESCENA" Foreground="#8CA0B6" FontSize="10" FontWeight="SemiBold"/>

        <StackPanel x:Name="RenderModeRail" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">

          <Button x:Name="RenderRailScene" Tag="0" Click="RenderRail_Click" Style="{StaticResource RenderRailButton}" Width="48" ToolTip="{DynamicResource RenderPanel.RailEnvironmentHint}">
            <StackPanel Orientation="Vertical"><TextBlock Text="&#xE706;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
              <TextBlock Text="{DynamicResource RenderPanel.RailEnvironment}" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
          </Button>
          <Button x:Name="RenderRailImage" Tag="1" Click="RenderRail_Click" Style="{StaticResource RenderRailButton}" Width="48" ToolTip="{DynamicResource RenderPanel.RailImageHint}">
            <StackPanel Orientation="Vertical"><TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
              <TextBlock Text="{DynamicResource RenderPanel.RailImage}" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
          </Button>
          <Button x:Name="RenderRailCamera" Tag="2" Click="RenderRail_Click" Style="{StaticResource RenderRailButton}" Width="48" ToolTip="{DynamicResource RenderPanel.RailCameraHint}">
            <StackPanel Orientation="Vertical"><TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
              <TextBlock Text="{DynamicResource RenderPanel.RailCamera}" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
          </Button>
          <Button x:Name="RenderRailMaterials" Tag="3" Click="RenderRail_Click" Style="{StaticResource RenderRailButton}" Width="48" ToolTip="{DynamicResource RenderPanel.RailMaterialHint}">
            <StackPanel Orientation="Vertical"><TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
              <TextBlock Text="{DynamicResource RenderPanel.RailMaterial}" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
          </Button>
          <Button x:Name="RenderRailQuality" Tag="4" Click="RenderRail_Click" Style="{StaticResource RenderRailButton}" Width="48" ToolTip="{DynamicResource RenderPanel.RailQualityHint}">
            <StackPanel Orientation="Vertical"><TextBlock Text="&#xE9E9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
              <TextBlock Text="{DynamicResource RenderPanel.RailQuality}" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
          </Button>
          <Button x:Name="RenderRailAi" Click="AiRender_Click" Style="{StaticResource RenderRailButton}" Width="48" ToolTip="{DynamicResource RenderPanel.RailAiHint}">
            <StackPanel Orientation="Vertical">
              <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
              <TextBlock Text="{DynamicResource RenderPanel.RailAi}" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
          </Button>
        </StackPanel>

          </StackPanel>
        </Border>

      <Border DockPanel.Dock="Top" Style="{StaticResource SettingsCard}" Margin="12,10,12,0" Padding="12,10" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="{DynamicResource RenderPanel.Scenes}" Style="{StaticResource PanelTitle}"/>
          <ComboBox x:Name="ScenePicker" ToolTip="{DynamicResource RenderPanel.ScenesHint}"/>
          <UniformGrid Columns="3" Margin="0,8,0,0">
            <Button x:Name="SaveSceneButton" Content="{DynamicResource RenderPanel.SceneSave}" Click="SaveRenderScene_Click" Style="{StaticResource ViewportToolButton}"/>
            <Button x:Name="OpenSceneButton" Content="{DynamicResource RenderPanel.SceneOpen}" Click="OpenRenderScene_Click" Style="{StaticResource ViewportToolButton}"/>
            <Button x:Name="DeleteSceneButton" Content="{DynamicResource RenderPanel.SceneDelete}" Click="DeleteRenderScene_Click" Style="{StaticResource ViewportToolButton}"/>
          </UniformGrid>
        </StackPanel>
      </Border>
      <StackPanel x:Name="SectionContext" DockPanel.Dock="Top" Margin="18,14,18,10">
        <TextBlock x:Name="SectionHeading" Text="Entorno" FontSize="22" FontWeight="SemiBold" Foreground="#F3F6FB"/>
        <TextBlock x:Name="SectionDescription" Text="Define la luz y la atmósfera de tu imagen." FontSize="12" Foreground="#9AAFC5" TextWrapping="Wrap" Margin="0,5,0,0"/>
      </StackPanel>
      <!-- Render actions remain available in every settings section. -->
      <Border DockPanel.Dock="Bottom" Style="{StaticResource SettingsCard}" Margin="12,8,12,8" Padding="10,6">
        <StackPanel>
          <Button x:Name="PauseButton" Content="{DynamicResource RenderPanel.Pause}"
                  Click="PauseButton_Click" MinHeight="28" Padding="16,4" IsEnabled="False">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ViewportToolButton}">
              <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
            </Style></Button.Style>
          </Button>
          <Grid Margin="0,2,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ToggleButton x:Name="PreviewToggle" IsChecked="False" Style="{StaticResource PreviewSwitch}" Margin="0,0,4,0"
                          Checked="PreviewToggle_Changed" Unchecked="PreviewToggle_Changed"
                          Content="{DynamicResource RenderPanel.Preview}" ToolTip="{DynamicResource RenderPanel.PreviewHint}"/>
            <Button x:Name="ShowImageButton" Grid.Column="1" Grid.ColumnSpan="2" Content="{DynamicResource RenderPanel.ShowImage}" Click="ShowImage_Click"
                    IsEnabled="False" Style="{StaticResource ViewportToolButton}" Padding="10,7" MinHeight="34" ToolTip="{DynamicResource RenderPanel.ShowImageHint}"/>
            <Button x:Name="SaveButton" Grid.Row="1" Grid.ColumnSpan="2" Click="SaveButton_Click" IsEnabled="False" Style="{StaticResource ViewportToolButton}" Padding="8,7" MinHeight="34"
                    Margin="0,6,4,0" ToolTip="{DynamicResource RenderPanel.SaveImage}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{DynamicResource RenderPanel.SaveShort}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="CopyButton" Grid.Row="1" Grid.Column="2" Click="CopyButton_Click" IsEnabled="False" Style="{StaticResource ViewportToolButton}" Padding="10,7" MinHeight="34"
