                  <TextBlock Style="{StaticResource PanelLabel}" Margin="0,12,0,0" Text="{DynamicResource Render.Weather.Wet}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=WetnessSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="WetnessSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="Lighting_SliderChanged"/>
                  </DockPanel>
                  <TextBlock Style="{StaticResource PanelLabel}" Margin="0,12,0,0" Text="{DynamicResource Render.Grass.Height}"/>
                  <DockPanel>
                    <TextBlock Style="{StaticResource SliderValue}" Text="{Binding Value, ElementName=GrassSlider, StringFormat={}{0:0%}}"/>
                    <Slider x:Name="GrassSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"
