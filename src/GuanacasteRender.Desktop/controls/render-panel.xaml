                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="12,7,4,4">
                      <TextBlock Text="{DynamicResource RenderPanel.Hour}" Foreground="#A7A7AC" FontSize="10"/>
                      <TextBlock Text="{Binding Value, ElementName=HourSlider, StringFormat={}{0:0.0} h}" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,7,4,4">
                      <TextBlock Text="{DynamicResource RenderPanel.Clouds}" Foreground="#A7A7AC" FontSize="10"/>
                      <TextBlock Text="{Binding Value, ElementName=CloudSlider, StringFormat={}{0:0} %}" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,7,8,4">
                      <TextBlock Text="{DynamicResource RenderPanel.SkyPreset}" Foreground="#A7A7AC" FontSize="10" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding SelectedItem.Content, ElementName=SkyPicker}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
