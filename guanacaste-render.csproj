<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GuanacasteRender</AssemblyName>
    <Product>Guanacaste Render</Product>
    <Version>1.0.1</Version>
    <ApplicationIcon>src\GuanacasteRender.Desktop\resources\brand\guanacaste3d.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ReleaseDate" Value="2026-11-06" />
    <RuntimeHostConfigurationOption Include="System.GC.LOHThreshold" Value="8388608" />
    <Compile Include="program.cs" />
    <ProjectReference Include="src/GuanacasteRender.Desktop/GuanacasteRender.Desktop.csproj" />
  </ItemGroup>
  <Target Name="RemoveStandaloneDesktopHostFromRenderOutput" AfterTargets="Build;Publish">
    <Delete Files="$(OutDir)Guanacaste3D.Desktop.exe" Condition="Exists('$(OutDir)Guanacaste3D.Desktop.exe')" />
    <Delete Files="$(PublishDir)Guanacaste3D.Desktop.exe"
            Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)Guanacaste3D.Desktop.exe')" />
  </Target>
</Project>
